# Default behavior is safe manual entry. Do not commit a real secrets.toml.
LABMIND_VISION_MODE = "manual"

# To enable the optional Gemini label extractor and chemistry classifier:
# LABMIND_VISION_MODE = "live"
# LABMIND_PROVIDER = "gemini"
# GEMINI_API_KEY = "replace-with-a-secret"
# GEMINI_MODEL = "gemini-3.6-flash"

# Optional local development location. Streamlit Community Cloud does not
# guarantee durable local-file storage, so do not treat this SQLite setting as
# a production inventory database.
# LABMIND_DB_PATH = "inventory.db"
