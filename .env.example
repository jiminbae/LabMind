# Keep live credentials in .env.local, never in this example file.
LABMIND_VISION_MODE=mock
LABMIND_PROVIDER=openai

# Official OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# UniVibe provider (uses a separate UniVibe-issued key)
UNIVIBE_API_KEY=
UNIVIBE_BASE_URL=https://api.univibe.cc/openai/v1
UNIVIBE_MODEL=gpt-5.4
